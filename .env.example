# PolyQuery MCP 配置文件
# 复制此文件为 .env 并填写实际的数据库连接信息

# ==================== 数据库连接 ====================
# 只需配置实际使用的数据库

# PostgreSQL: postgresql://用户名:密码@主机:端口/数据库名
POSTGRES_URL=postgresql://username:password@localhost:5432/database

# MySQL: mysql://用户名:密码@主机:端口/数据库名
MYSQL_URL=mysql://username:password@localhost:3306/database

# MongoDB: mongodb://用户名:密码@主机:端口/数据库名
# 或 MongoDB Atlas: mongodb+srv://用户名:密码@cluster.mongodb.net/数据库名
MONGODB_URL=mongodb://username:password@localhost:27017/database

# Redis: redis://[:密码@]主机:端口[/数据库号]
REDIS_URL=redis://localhost:6379/0

# Oracle: oracle://用户名:密码@主机:端口/服务名
ORACLE_URL=oracle://username:password@localhost:1521/ORCL

# ==================== 安全配置 ====================

# 只读模式 - 禁止INSERT/UPDATE/DELETE等写操作
READ_ONLY_MODE=true

# 最大返回行数
MAX_ROWS=1000

# 查询超时（秒）
QUERY_TIMEOUT=30

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
