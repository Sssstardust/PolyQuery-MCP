# PolyQuery MCP 配置
# 复制此文件为 .env 并填写实际的数据库连接信息
#
# 配置规则: {DB_TYPE}_{name}=连接字符串
# - DB_TYPE 不区分大小写，统一按小写处理
# - name 为自定义数据源名称，第一个 _ 后的全部内容均为 name
# - 例: MYSQL_primary、ORACLE_tob、MYSQL_order_db

# ==================== MySQL ====================
MYSQL_primary=mysql://username:password@localhost:3306/database
# MYSQL_replica=mysql://username:password@replica:3306/database

# ==================== PostgreSQL ====================
POSTGRES_main=postgresql://username:password@localhost:5432/database
# POSTGRES_archive=postgresql://username:password@localhost:5432/archive

# ==================== MongoDB ====================
MONGODB_main=mongodb://username:password@localhost:27017/database

# ==================== Redis ====================
# 密码中含特殊字符（如 #）需 URL 编码，如 # → %23
REDIS_cache=redis://:password@localhost:6379/0
# REDIS_session=redis://:password@localhost:6379/1

# ==================== Oracle ====================
# 密码中含特殊字符（如 $ ! ^）需 URL 编码，如 $ → %24
ORACLE_main=oracle://username:password@localhost:1521/ORCL

# ==================== SQLite ====================
SQLITE_main=/path/to/database.db

# ==================== 安全配置 ====================

# 只读模式 - 禁止 INSERT/UPDATE/DELETE 等写操作
READ_ONLY_MODE=true

# 最大返回行数
MAX_ROWS=1000

# 查询超时（毫秒）
QUERY_TIMEOUT=30000

# 日志级别
LOG_LEVEL=INFO
