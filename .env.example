# PolyQuery MCP 配置
# 复制此文件为 .env 并填写实际的数据库连接信息

# ==================== 数据库连接 ====================
# 只需配置实际使用的数据库

# MySQL
MYSQL_URL=mysql://username:password@localhost:3306/database

# PostgreSQL
POSTGRES_URL=postgresql://username:password@localhost:5432/database

# MongoDB (支持 mongodb:// 和 mongodb+srv://)
MONGODB_URL=mongodb://username:password@localhost:27017/database

# Redis
REDIS_URL=redis://:password@localhost:6379/0

# Oracle
ORACLE_URL=oracle://username:password@localhost:1521/ORCL

# ==================== 安全配置 ====================

# 只读模式 - 禁止 INSERT/UPDATE/DELETE 等写操作
READ_ONLY_MODE=true

# 最大返回行数
MAX_ROWS=1000

# 查询超时（毫秒）
QUERY_TIMEOUT=30000

# 日志级别
LOG_LEVEL=INFO
