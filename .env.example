# PolyQuery MCP 闁板秶鐤?# 婢跺秴鍩楀銈嗘瀮娴犳湹璐?.env 楠炶泛锝為崘娆忕杽闂勫懐娈戦弫鐗堝祦鎼存捁绻涢幒銉や繆閹?
# ==================== 閺佺増宓佹惔鎾圭箾閹?====================
# 閸欘亪娓堕柊宥囩枂鐎圭偤妾担璺ㄦ暏閻ㄥ嫭鏆熼幑顔肩氨

# MySQL
MYSQL_URL=mysql://username:password@localhost:3306/database

# PostgreSQL
POSTGRES_URL=postgresql://username:password@localhost:5432/database

# MongoDB (閺€顖涘瘮 mongodb:// 閸?mongodb+srv://)
MONGODB_URL=mongodb://username:password@localhost:27017/database

# Redis
REDIS_URL=redis://:password@localhost:6379/0

# Oracle
ORACLE_URL=oracle://username:password@localhost:1521/ORCL

# ==================== 鐎瑰鍙忛柊宥囩枂 ====================

# 閸欘亣顕板Ο鈥崇础 - 缁備焦顒?INSERT/UPDATE/DELETE 缁涘鍟撻幙宥勭稊
READ_ONLY_MODE=true

# 閺堚偓婢堆嗙箲閸ョ偠顢戦弫?MAX_ROWS=1000

# 閺屻儴顕楃搾鍛閿涘牊顕犵粔鎺炵礆
QUERY_TIMEOUT=30000

# 閺冦儱绻旂痪褍鍩?LOG_LEVEL=INFO
